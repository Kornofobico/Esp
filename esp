local function CreateToggle(name, displayName, layoutOrder)
	local container = Instance.new("Frame")
	container.Name = name .. "Toggle"
	container.Size = UDim2.new(1, 0, 0, 36)
	container.BackgroundColor3 = Colors.BackgroundLight
	container.LayoutOrder = layoutOrder
	container.Parent = Content
	AddCorner(container, 10)
	AddStroke(container, Colors.GoldDark, 1)
	
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(0.7, -10, 1, 0)
	label.Position = UDim2.new(0, 15, 0, 0)
	label.BackgroundTransparency = 1
	label.Text = displayName
	label.TextColor3 = Colors.Gold
	label.TextSize = 14
	label.Font = Enum.Font.GothamMedium
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = container
	
	local toggleBg = Instance.new("Frame")
	toggleBg.Name = "ToggleBg"
	toggleBg.Size = UDim2.new(0, 50, 0, 24)
	toggleBg.Position = UDim2.new(1, -65, 0.5, -12)
	toggleBg.BackgroundColor3 = Colors.RedDark
	toggleBg.Parent = container
	AddCorner(toggleBg, 12)
	
	local toggleKnob = Instance.new("Frame")
	toggleKnob.Name = "ToggleKnob"
	toggleKnob.Size = UDim2.new(0, 20, 0, 20)
	toggleKnob.Position = UDim2.new(0, 2, 0.5, -10)
	toggleKnob.BackgroundColor3 = Colors.White
	toggleKnob.Parent = toggleBg
	AddCorner(toggleKnob, 10)
	
	local button = Instance.new("TextButton")
	button.Size = UDim2.new(1, 0, 1, 0)
	button.BackgroundTransparency = 1
	button.Text = ""
	button.Parent = container
	
	button.MouseButton1Click:Connect(function()
		toggleStates[name] = not toggleStates[name]
		local isOn = toggleStates[name]
		
		local tweenInfo = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		
		if isOn then
			TweenService:Create(toggleBg, tweenInfo, {BackgroundColor3 = Colors.Gold}):Play()
			TweenService:Create(toggleKnob, tweenInfo, {Position = UDim2.new(1, -22, 0.5, -10)}):Play()
		else
			TweenService:Create(toggleBg, tweenInfo, {BackgroundColor3 = Colors.RedDark}):Play()
			TweenService:Create(toggleKnob, tweenInfo, {Position = UDim2.new(0, 2, 0.5, -10)}):Play()
		end
		
		updateAllESP()
		SaveConfig()
	end)
	
	return container
end

