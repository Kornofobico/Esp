-- ========== UI HELPER FUNCTIONS ==========
local function AddCorner(parent, radius)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius or 12)
	corner.Parent = parent
	return corner
end

local function AddStroke(parent, color, thickness)
	local stroke = Instance.new("UIStroke")
	stroke.Color = color or Colors.Gold
	stroke.Thickness = thickness or 2
	stroke.Parent = parent
	return stroke
end

local function AddGradient(parent, color1, color2, rotation)
	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, color1),
		ColorSequenceKeypoint.new(1, color2)
	})
	gradient.Rotation = rotation or 90
	gradient.Parent = parent
	return gradient
end

-- ========== ESP CREATION FUNCTIONS ==========
local function createESP(targetPlayer)
	if targetPlayer == player or ESPInstances[targetPlayer.Name] then return end
	if targetPlayer.Character == nil then return end
	
	local character = targetPlayer.Character
	local head = character:FindFirstChild("Head")
	local humanoid = character:FindFirstChildWhichIsA("Humanoid")
	
	if not head or not humanoid then return end
	
	local espData = {
		player = targetPlayer,
		character = character,
		humanoid = humanoid,
		highlight = nil,
		billboardGui = nil,
		connections = {}
	}
	
	-- Create Highlight
	local highlight = Instance.new("Highlight")
	highlight.Name = "MergedESP_Highlight"
	highlight.Adornee = character
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Enabled = toggleStates.EliteHighlights
	highlight.FillTransparency = Config.Highlight_Transparency
	highlight.OutlineTransparency = Config.Highlight_Transparency
	highlight.FillColor = targetPlayer.TeamColor.Color
	highlight.OutlineColor = targetPlayer.TeamColor.Color
	highlight.Parent = character
	espData.highlight = highlight
	
	-- Create BillboardGui for names and health bar
	local billboardGui = Instance.new("BillboardGui")
	billboardGui.Name = "MergedESP_BillboardGui"
	billboardGui.Size = UDim2.new(0, 200, 0, 60)
	billboardGui.AlwaysOnTop = true
	billboardGui.StudsOffset = Vector3.new(0, 3, 0)
	billboardGui.Enabled = toggleStates.VIPNicks or toggleStates.GoldBarz
	billboardGui.Adornee = head
	billboardGui.Parent = ESPHolder
	espData.billboardGui = billboardGui
	
	-- Container
	local container = Instance.new("Frame", billboardGui)
	container.Size = UDim2.new(1, 0, 1, 0)
	container.BackgroundTransparency = 1
	
	-- Name Label
	local nameLabel = Instance.new("TextLabel", container)
	nameLabel.Name = "NameLabel"
	nameLabel.BackgroundTransparency = 1
	nameLabel.Size = UDim2.new(1, 0, 0, 14)
	nameLabel.Font = Enum.Font.SourceSansBold
	nameLabel.TextSize = 14
	nameLabel.TextStrokeTransparency = 0.5
	nameLabel.TextColor3 = targetPlayer.TeamColor.Color
	nameLabel.Visible = toggleStates.VIPNicks
	nameLabel.Text = targetPlayer.DisplayName ~= "" and targetPlayer.DisplayName or targetPlayer.Name
	
	-- Health Bar Background
	local healthBG = Instance.new("Frame", container)
	healthBG.Name = "HealthBG"
	healthBG.BackgroundColor3 = Color3.fromRGB(50, 0, 0)
	healthBG.BorderSizePixel = 0
	healthBG.Size = UDim2.new(0, 50, 0, 3)
	healthBG.AnchorPoint = Vector2.new(0.5, 0)
	healthBG.Visible = toggleStates.GoldBarz
	healthBG.Position = toggleStates.VIPNicks and UDim2.new(0.5, 0, 0, 16) or UDim2.new(0.5, 0, 0, 0)
	
	-- Health Bar Fill
	local healthFill = Instance.new("Frame", healthBG)
	healthFill.Name = "HealthFill"
	healthFill.BackgroundColor3 = HealthBarColor
	healthFill.BorderSizePixel = 0
	healthFill.Size = UDim2.new(1, 0, 1, 0)
	
	-- Update function
	local function updateESP()
		if not character.Parent or not humanoid then return end
		
		-- Update Highlight
		if highlight then
			highlight.Enabled = toggleStates.EliteHighlights
			highlight.FillTransparency = Config.Highlight_Transparency
			highlight.OutlineTransparency = Config.Highlight_Transparency
			highlight.FillColor = targetPlayer.TeamColor.Color
			highlight.OutlineColor = targetPlayer.TeamColor.Color
		end
		
		-- Update Billboard
		if billboardGui then
			billboardGui.Enabled = toggleStates.VIPNicks or toggleStates.GoldBarz
			nameLabel.Visible = toggleStates.VIPNicks
			nameLabel.Text = targetPlayer.DisplayName ~= "" and targetPlayer.DisplayName or targetPlayer.Name
			nameLabel.TextColor3 = targetPlayer.TeamColor.Color
			
			-- Update health bar position
			if toggleStates.VIPNicks then
				healthBG.Position = UDim2.new(0.5, 0, 0, 16)
			else
				healthBG.Position = UDim2.new(0.5, 0, 0, 0)
			end
			
			healthBG.Visible = toggleStates.GoldBarz
			
			-- Update health bar fill
			local healthPercent = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
			healthFill.Size = UDim2.new(healthPercent, 0, 1, 0)
			healthFill.BackgroundColor3 = Color3.fromRGB(255 * (1 - healthPercent), 255 * healthPercent, 0)
			healthBG.Size = UDim2.new(0, math.max(50, nameLabel.TextBounds.X), 0, 3)
		end
		
		-- Hide default display
		pcall(function() humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end)
	end
	
	-- Connect signals
	table.insert(espData.connections, targetPlayer:GetPropertyChangedSignal("TeamColor"):Connect(updateESP))
	table.insert(espData.connections, humanoid.HealthChanged:Connect(updateESP))
	table.insert(espData.connections, humanoid:GetPropertyChangedSignal("MaxHealth"):Connect(updateESP))
	
	-- Initial update
	updateESP()
	
	-- Store ESP instance
	ESPInstances[targetPlayer.Name] = espData
end

local function updateAllESP()
	for _, playerESP in pairs(ESPInstances) do
		if playerESP.character and playerESP.character.Parent then
			-- Update visibility and transparency based on toggles
			if playerESP.highlight then
				playerESP.highlight.Enabled = toggleStates.EliteHighlights
				playerESP.highlight.FillTransparency = Config.Highlight_Transparency
				playerESP.highlight.OutlineTransparency = Config.Highlight_Transparency
			end
			if playerESP.billboardGui then
				playerESP.billboardGui.Enabled = toggleStates.VIPNicks or toggleStates.GoldBarz
				local nameLabel = playerESP.billboardGui:FindFirstChild("Frame"):FindFirstChild("NameLabel")
				local healthBG = playerESP.billboardGui:FindFirstChild("Frame"):FindFirstChild("HealthBG")
				if nameLabel then nameLabel.Visible = toggleStates.VIPNicks end
				if healthBG then healthBG.Visible = toggleStates.GoldBarz end
			end
		end
	end
end

local function removeESP(targetPlayer)
	local espData = ESPInstances[targetPlayer.Name]
	if not espData then return end
	
	-- Disconnect all signals
	for _, connection in pairs(espData.connections) do
		connection:Disconnect()
	end
	
	-- Destroy GUI elements
	if espData.highlight then
		espData.highlight:Destroy()
	end
	if espData.billboardGui then
		espData.billboardGui:Destroy()
	end
	
	ESPInstances[targetPlayer.Name] = nil
end

-- ========== PLAYER TRACKING ==========
local function onPlayerAdded(targetPlayer)
	if targetPlayer == player then return end
	
	targetPlayer.CharacterAdded:Connect(function()
		task.wait(0.1) -- Wait for character to fully load
		createESP(targetPlayer)
	end)
	
	if targetPlayer.Character then
		task.spawn(function()
			task.wait(0.1)
			createESP(targetPlayer)
		end)
	end
end

local function onPlayerRemoved(targetPlayer)
	removeESP(targetPlayer)
end

-- Load existing players
for _, targetPlayer in pairs(Players:GetPlayers()) do
	if targetPlayer ~= player then
		task.spawn(function() onPlayerAdded(targetPlayer) end)
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoved)

